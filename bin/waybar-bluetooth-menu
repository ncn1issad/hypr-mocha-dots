#!/usr/bin/env python3
"""Catppuccin fuzzel Bluetooth manager menu for Waybar."""

from __future__ import annotations

import json
import os
import re
import shutil
import signal
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PID_FILE = RUNTIME_DIR / "waybar-bluetooth-menu.pid"
OTHER_PID_FILES = [
    RUNTIME_DIR / "waybar-network-menu.pid",
    RUNTIME_DIR / "waybar-power-menu.pid",
    RUNTIME_DIR / "waybar-output-menu.pid",
    RUNTIME_DIR / "waybar-input-menu.pid",
    RUNTIME_DIR / "waybar-battery-menu.pid",
    RUNTIME_DIR / "waybar-clipboard-menu.pid",
]

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\r")
MAC_RE = re.compile(r"^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$")
DEVICE_LINE_RE = re.compile(r"^Device\s+([0-9A-Fa-f:]{17})\s+(.*)$")
BATTERY_RE = re.compile(r"\((\d+)\)")

DEVICE_ICONS = {
    "audio-headset": "󰋎",
    "audio-headphones": "󰋋",
    "audio-card": "󰓃",
    "audio-speakers": "󰓃",
    "multimedia-player": "󰓃",
    "input-keyboard": "󰌌",
    "input-mouse": "󰍽",
    "input-gaming": "󰊴",
    "phone": "󰏲",
    "computer": "󰌢",
    "camera-photo": "󰄀",
    "camera-video": "󰄀",
}


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text)


def run_cmd(
    args: list[str],
    input_text: str | None = None,
    timeout: float | None = 15.0,
) -> subprocess.CompletedProcess[str]:
    try:
        res = subprocess.run(
            args,
            input=input_text,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
        return subprocess.CompletedProcess(
            args,
            res.returncode,
            strip_ansi(res.stdout),
            strip_ansi(res.stderr),
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(args, 127, "", f"{args[0]} not found")
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else (exc.stdout or b"").decode(errors="ignore")
        err = exc.stderr if isinstance(exc.stderr, str) else (exc.stderr or b"").decode(errors="ignore")
        return subprocess.CompletedProcess(
            args,
            124,
            strip_ansi(out),
            strip_ansi(err) or "Command timed out",
        )


def notify(summary: str, body: str = "", urgency: str = "low") -> None:
    cmd = [
        "notify-send",
        "-a",
        "Bluetooth",
        "-u",
        urgency,
        "-h",
        "string:x-canonical-private-synchronous:waybar-bluetooth",
        summary,
    ]
    if body:
        cmd.append(body)
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def copy_to_clipboard(text: str, label: str = "") -> None:
    res = run_cmd(["wl-copy"], input_text=text, timeout=5.0)
    if res.returncode == 0:
        notify("Copied to clipboard", f"{label}: {text}" if label else text)


def kill_pidfile(path: Path) -> bool:
    if not path.exists():
        return False
    try:
        pid = int(path.read_text().strip())
    except ValueError:
        path.unlink(missing_ok=True)
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
        if b"fuzzel" in cmdline:
            os.kill(pid, signal.SIGTERM)
            path.unlink(missing_ok=True)
            return True
    except OSError:
        pass
    path.unlink(missing_ok=True)
    return False


def detect_cursor_output() -> str | None:
    pos_res = run_cmd(["hyprctl", "cursorpos", "-j"], timeout=3.0)
    mon_res = run_cmd(["hyprctl", "monitors", "-j"], timeout=3.0)
    if pos_res.returncode != 0 or mon_res.returncode != 0:
        return None
    try:
        pos = json.loads(pos_res.stdout)
        monitors = json.loads(mon_res.stdout)
        cx, cy = float(pos["x"]), float(pos["y"])
        for mon in monitors:
            scale = float(mon.get("scale", 1) or 1)
            transform = int(mon.get("transform", 0) or 0)
            w = float(mon["width"]) / scale
            h = float(mon["height"]) / scale
            if transform in (1, 3, 5, 7):
                w, h = h, w
            mx, my = float(mon["x"]), float(mon["y"])
            if mx <= cx < mx + w and my <= cy < my + h:
                return str(mon["name"])
    except (ValueError, KeyError, TypeError):
        return None
    return None


def fuzzel_select(
    entries: list[tuple[str, object]],
    output: str | None,
    prompt: str = "󰂯  ",
    placeholder: str = "Search devices or actions...",
    max_lines: int = 16,
    width: int = 38,
) -> object | None:
    cmd = [
        "fuzzel",
        "--dmenu",
        "--index",
        "--minimal-lines",
        f"--lines={min(max_lines, max(1, len(entries)))}",
        "--anchor=top-right",
        "--x-margin=10",
        "--y-margin=10",
        f"--width={width}",
        f"--prompt={prompt}",
        f"--placeholder={placeholder}",
    ]
    if output:
        cmd.append(f"--output={output}")

    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    PID_FILE.write_text(str(proc.pid))
    try:
        stdout, _ = proc.communicate("\n".join(label for label, _ in entries))
    finally:
        try:
            if PID_FILE.exists() and PID_FILE.read_text().strip() == str(proc.pid):
                PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass

    if proc.returncode != 0:
        return None
    try:
        return entries[int(stdout.strip())][1]
    except (ValueError, IndexError):
        return None


def rfkill_state() -> tuple[bool, bool]:
    """Return (soft_blocked, hard_blocked) for Bluetooth adapters."""
    if not shutil.which("rfkill"):
        return False, False
    res = run_cmd(["rfkill", "-J", "list", "bluetooth"], timeout=3.0)
    if res.returncode == 0 and res.stdout.strip():
        try:
            data = json.loads(res.stdout)
            entries = data.get("rfkilldevices", []) if isinstance(data, dict) else []
            if entries:
                soft = all(str(e.get("soft", "")).lower() == "blocked" for e in entries)
                hard = all(str(e.get("hard", "")).lower() == "blocked" for e in entries)
                return soft, hard
        except json.JSONDecodeError:
            pass
    return False, False


def get_controller() -> dict[str, object] | None:
    res = run_cmd(["bluetoothctl", "show"], timeout=5.0)
    if res.returncode != 0 or "No default controller available" in res.stdout:
        return None

    info: dict[str, object] = {
        "address": "",
        "name": "",
        "alias": "Bluetooth",
        "powered": False,
        "discoverable": False,
        "pairable": False,
        "discovering": False,
    }
    found = False
    for line in res.stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("Controller "):
            parts = stripped.split()
            if len(parts) >= 2:
                info["address"] = parts[1]
                found = True
        elif ":" in stripped:
            key, val = stripped.split(":", 1)
            key = key.strip()
            val = val.strip()
            if key == "Name":
                info["name"] = val
            elif key == "Alias":
                info["alias"] = val
            elif key == "Powered":
                info["powered"] = val.lower() == "yes"
            elif key == "Discoverable":
                info["discoverable"] = val.lower() == "yes"
            elif key == "Pairable":
                info["pairable"] = val.lower() == "yes"
            elif key == "Discovering":
                info["discovering"] = val.lower() == "yes"

    return info if found else None


def set_power(enable: bool) -> tuple[bool, str]:
    if enable:
        soft_blocked, hard_blocked = rfkill_state()
        if hard_blocked:
            return False, "Bluetooth is blocked by a hardware switch."
        if soft_blocked and shutil.which("rfkill"):
            run_cmd(["rfkill", "unblock", "bluetooth"], timeout=5.0)
        res = run_cmd(["bluetoothctl", "power", "on"], timeout=8.0)
    else:
        res = run_cmd(["bluetoothctl", "power", "off"], timeout=8.0)

    if res.returncode == 0 and "Failed" not in res.stdout:
        return True, ""
    err = (res.stderr or res.stdout).strip()
    return False, err or f"Failed to turn Bluetooth {'on' if enable else 'off'}"


def toggle_power() -> int:
    ctrl = get_controller()
    if ctrl is None:
        soft_blocked, hard_blocked = rfkill_state()
        if hard_blocked:
            notify("Bluetooth unavailable", "Blocked by hardware switch", "critical")
            return 1
        if soft_blocked:
            ok, err = set_power(True)
            if ok:
                notify("Bluetooth enabled")
                return 0
            notify("Failed to enable Bluetooth", err, "critical")
            return 1
        notify("Bluetooth unavailable", "No Bluetooth controller found", "critical")
        return 1

    target = not bool(ctrl["powered"])
    ok, err = set_power(target)
    if ok:
        notify("Bluetooth enabled" if target else "Bluetooth disabled")
        return 0
    notify(f"Failed to {'enable' if target else 'disable'} Bluetooth", err, "critical")
    return 1


def parse_device_list(args: list[str]) -> list[tuple[str, str]]:
    res = run_cmd(["bluetoothctl", *args], timeout=5.0)
    if res.returncode != 0:
        return []
    devices: list[tuple[str, str]] = []
    seen: set[str] = set()
    for line in res.stdout.splitlines():
        match = DEVICE_LINE_RE.match(line.strip())
        if match:
            mac, name = match.group(1), match.group(2).strip()
            if mac not in seen:
                seen.add(mac)
                devices.append((mac, name))
    return devices


def get_device_info(mac: str, fallback_name: str = "") -> dict[str, object]:
    res = run_cmd(["bluetoothctl", "info", mac], timeout=5.0)
    info: dict[str, object] = {
        "mac": mac,
        "name": fallback_name or mac,
        "alias": fallback_name or mac,
        "icon": "",
        "paired": False,
        "bonded": False,
        "trusted": False,
        "blocked": False,
        "connected": False,
        "battery": None,
    }
    if res.returncode != 0:
        return info

    for line in res.stdout.splitlines():
        stripped = line.strip()
        if ":" not in stripped:
            continue
        key, val = stripped.split(":", 1)
        key = key.strip()
        val = val.strip()
        if key == "Name":
            info["name"] = val
        elif key == "Alias":
            info["alias"] = val
        elif key == "Icon":
            info["icon"] = val
        elif key == "Paired":
            info["paired"] = val.lower() == "yes"
        elif key == "Bonded":
            info["bonded"] = val.lower() == "yes"
        elif key == "Trusted":
            info["trusted"] = val.lower() == "yes"
        elif key == "Blocked":
            info["blocked"] = val.lower() == "yes"
        elif key == "Connected":
            info["connected"] = val.lower() == "yes"
        elif key == "Battery Percentage":
            m = BATTERY_RE.search(val)
            if m:
                try:
                    info["battery"] = int(m.group(1))
                except ValueError:
                    pass
    return info


def fetch_devices(include_unpaired: bool = False) -> list[dict[str, object]]:
    paired_raw = parse_device_list(["devices", "Paired"])
    connected_raw = parse_device_list(["devices", "Connected"])

    targets: dict[str, str] = {}
    for mac, name in connected_raw:
        targets[mac] = name
    for mac, name in paired_raw:
        targets.setdefault(mac, name)

    if include_unpaired:
        for mac, name in parse_device_list(["devices"]):
            if mac in targets:
                continue
            # Filter out nameless BLE advertisements whose alias is just a MAC address.
            if not name or MAC_RE.match(name):
                continue
            targets[mac] = name

    if not targets:
        return []

    items = list(targets.items())
    with ThreadPoolExecutor(max_workers=min(8, len(items))) as pool:
        infos = list(pool.map(lambda pair: get_device_info(pair[0], pair[1]), items))

    infos.sort(
        key=lambda d: (
            not bool(d["connected"]),
            not bool(d["paired"]),
            str(d["alias"]).lower(),
        )
    )
    return infos


def device_icon(dev: dict[str, object]) -> str:
    icon_name = str(dev.get("icon", "")).lower()
    if icon_name in DEVICE_ICONS:
        return DEVICE_ICONS[icon_name]
    alias = str(dev.get("alias", "")).lower()
    if any(word in alias for word in ("headset", "airpods", "buds", "earbuds", "freebuds")):
        return "󰋎"
    if any(word in alias for word in ("headphone", "wh-", "qc", "momentum", "beats", "bose", "sony")):
        return "󰋋"
    if any(word in alias for word in ("speaker", "jbl", "soundlink", "marshall", "sonos")):
        return "󰓃"
    if any(word in alias for word in ("keyboard", "keychron", "hhkb", "nuphy")):
        return "󰌌"
    if any(word in alias for word in ("mouse", "mx master", "mx anywhere", "trackpad")):
        return "󰍽"
    if any(word in alias for word in ("controller", "dualsense", "xbox", "joy-con", "gamepad")):
        return "󰊴"
    return "󰂯"


def format_device_label(dev: dict[str, object]) -> str:
    icon = device_icon(dev)
    alias = str(dev["alias"])
    bat = dev.get("battery")
    bat_str = f" ({bat}%)" if isinstance(bat, int) else ""
    if dev["connected"]:
        return f"{icon}  {alias}{bat_str}  󰄬"
    if not dev["paired"]:
        return f"{icon}  {alias} (New)"
    return f"{icon}  {alias}"


def bt_error(res: subprocess.CompletedProcess[str], fallback: str) -> str:
    for stream in (res.stderr, res.stdout):
        lines = [line.strip() for line in stream.splitlines() if line.strip()]
        for line in reversed(lines):
            if "Failed" in line or "Error" in line or "not available" in line:
                return line
        if lines:
            return lines[-1]
    return fallback


def connect_device(dev: dict[str, object]) -> None:
    mac = str(dev["mac"])
    alias = str(dev["alias"])
    notify("Connecting...", alias)
    res = run_cmd(["bluetoothctl", "--timeout", "12", "connect", mac], timeout=15.0)
    if res.returncode == 0 and "Connection successful" in res.stdout:
        notify("Bluetooth connected", alias)
    else:
        notify(f"Failed to connect to {alias}", bt_error(res, "Connection failed"), "critical")


def disconnect_device(dev: dict[str, object]) -> None:
    mac = str(dev["mac"])
    alias = str(dev["alias"])
    res = run_cmd(["bluetoothctl", "--timeout", "8", "disconnect", mac], timeout=10.0)
    if res.returncode == 0 and "Failed" not in res.stdout:
        notify("Bluetooth disconnected", alias)
    else:
        notify(f"Failed to disconnect {alias}", bt_error(res, "Disconnect failed"), "critical")


def pair_and_connect(dev: dict[str, object]) -> None:
    mac = str(dev["mac"])
    alias = str(dev["alias"])
    notify("Pairing...", alias)
    pair_res = run_cmd(
        ["bluetoothctl", "--agent", "NoInputNoOutput", "--timeout", "15", "pair", mac],
        timeout=18.0,
    )
    paired_ok = pair_res.returncode == 0 and (
        "Pairing successful" in pair_res.stdout or "Already Exists" in pair_res.stdout
    )
    if not paired_ok:
        notify(f"Failed to pair with {alias}", bt_error(pair_res, "Pairing failed"), "critical")
        return

    run_cmd(["bluetoothctl", "trust", mac], timeout=5.0)
    conn_res = run_cmd(["bluetoothctl", "--timeout", "12", "connect", mac], timeout=15.0)
    if conn_res.returncode == 0 and "Connection successful" in conn_res.stdout:
        notify("Paired & connected", alias)
    else:
        notify(f"Paired with {alias}", "Could not connect automatically", "normal")


def show_device_info(output: str | None, dev: dict[str, object], show_discovered: bool) -> None:
    fresh = get_device_info(str(dev["mac"]), str(dev["alias"]))
    rows: list[tuple[str, str]] = [
        ("Alias", str(fresh["alias"])),
        ("Address", str(fresh["mac"])),
        ("Status", "Connected" if fresh["connected"] else "Disconnected"),
        ("Paired", "Yes" if fresh["paired"] else "No"),
        ("Trusted", "Yes" if fresh["trusted"] else "No"),
    ]
    if fresh.get("icon"):
        rows.append(("Type", str(fresh["icon"])))
    if isinstance(fresh.get("battery"), int):
        rows.append(("Battery", f"{fresh['battery']}%"))

    entries: list[tuple[str, object]] = [(f"󰆏  {k}: {v}", ("copy", (k, v))) for k, v in rows]
    entries.append(("󰁍  Back", ("back", None)))

    choice = fuzzel_select(
        entries,
        output,
        prompt="󰋽  ",
        placeholder="Select item to copy...",
        max_lines=12,
    )
    if not choice:
        return
    action, payload = choice
    if action == "copy":
        k, v = payload
        copy_to_clipboard(v, k)
    elif action == "back":
        show_device_actions(output, fresh, show_discovered)


def show_device_actions(output: str | None, dev: dict[str, object], show_discovered: bool) -> None:
    mac = str(dev["mac"])
    alias = str(dev["alias"])
    icon = device_icon(dev)

    entries: list[tuple[str, object]] = []
    if dev["connected"]:
        entries.append(("󰌙  Disconnect", ("disconnect", None)))
    else:
        entries.append(("󰂱  Connect", ("connect", None)))

    entries.append(("󰋽  Device Information", ("info", None)))
    if dev["trusted"]:
        entries.append(("󰕥  Untrust Device", ("untrust", None)))
    else:
        entries.append(("󰕥  Trust Device", ("trust", None)))
    entries.append(("󰧧  Forget Device", ("forget", None)))
    entries.append(("󰁍  Back", ("back", None)))

    choice = fuzzel_select(
        entries,
        output,
        prompt=f"{icon}  {alias} ",
        placeholder="Choose action...",
        max_lines=8,
    )
    if not choice:
        return

    action, _ = choice
    if action == "connect":
        connect_device(dev)
    elif action == "disconnect":
        disconnect_device(dev)
    elif action == "info":
        show_device_info(output, dev, show_discovered)
    elif action == "trust":
        res = run_cmd(["bluetoothctl", "trust", mac], timeout=5.0)
        if res.returncode == 0:
            notify("Device trusted", alias)
        else:
            notify(f"Failed to trust {alias}", bt_error(res, "Trust failed"), "critical")
    elif action == "untrust":
        res = run_cmd(["bluetoothctl", "untrust", mac], timeout=5.0)
        if res.returncode == 0:
            notify("Device untrusted", alias)
        else:
            notify(f"Failed to untrust {alias}", bt_error(res, "Untrust failed"), "critical")
    elif action == "forget":
        confirm = fuzzel_select(
            [
                (f"󰧧  Yes, forget {alias}", True),
                ("󰅖  Cancel", False),
            ],
            output,
            prompt="󰧧  ",
            placeholder="Confirm...",
            max_lines=3,
        )
        if confirm:
            res = run_cmd(["bluetoothctl", "remove", mac], timeout=8.0)
            if res.returncode == 0 and "Device has been removed" in res.stdout:
                notify("Device forgotten", alias)
            else:
                notify(f"Failed to forget {alias}", bt_error(res, "Remove failed"), "critical")
    elif action == "back":
        show_menu(output, show_discovered=show_discovered)


def show_manage_paired(output: str | None, devices: list[dict[str, object]], show_discovered: bool) -> None:
    paired = [d for d in devices if d["paired"]]
    entries: list[tuple[str, object]] = [(format_device_label(d), ("device", d)) for d in paired]
    entries.append(("󰁍  Back", ("back", None)))

    choice = fuzzel_select(
        entries,
        output,
        prompt="󰒓  ",
        placeholder="Select paired device...",
        max_lines=14,
    )
    if not choice:
        return
    action, payload = choice
    if action == "device":
        show_device_actions(output, payload, show_discovered)
    elif action == "back":
        show_menu(output, show_discovered=show_discovered)


def show_menu(output: str | None, show_discovered: bool = False) -> None:
    ctrl = get_controller()
    entries: list[tuple[str, object]] = []

    if ctrl is None:
        soft_blocked, hard_blocked = rfkill_state()
        if hard_blocked:
            entries.append(("󰂲  Bluetooth blocked by hardware switch", ("noop", None)))
        elif soft_blocked:
            entries.append(("󰂯  Enable Bluetooth", ("power_on", None)))
        else:
            entries.append(("󰂲  No Bluetooth controller found", ("noop", None)))
    elif not ctrl["powered"]:
        entries.append(("󰂯  Enable Bluetooth", ("power_on", None)))
    else:
        devices = fetch_devices(include_unpaired=show_discovered)
        paired = [d for d in devices if d["paired"]]
        for dev in devices:
            entries.append((format_device_label(dev), ("device", dev)))

        entries.append(("󰑐  Scan for Devices (5s)", ("scan", None)))
        if paired:
            entries.append((f"󰒓  Manage Paired Devices ({len(paired)})...", ("manage", devices)))

        if ctrl["discoverable"]:
            entries.append(("󰈈  Discoverable: On", ("discoverable_off", None)))
        else:
            entries.append(("󰈉  Discoverable: Off", ("discoverable_on", None)))
        entries.append(("󰂲  Disable Bluetooth", ("power_off", None)))

    choice = fuzzel_select(
        entries,
        output,
        prompt="󰂯  ",
        placeholder="Search devices or actions...",
        max_lines=16,
    )
    if not choice:
        return

    action, payload = choice
    if action == "power_on":
        ok, err = set_power(True)
        if ok:
            notify("Bluetooth enabled")
        else:
            notify("Failed to enable Bluetooth", err, "critical")
    elif action == "power_off":
        ok, err = set_power(False)
        if ok:
            notify("Bluetooth disabled")
        else:
            notify("Failed to disable Bluetooth", err, "critical")
    elif action == "device":
        dev = payload
        assert isinstance(dev, dict)
        if dev["connected"]:
            show_device_actions(output, dev, show_discovered)
        elif dev["paired"]:
            connect_device(dev)
        else:
            pair_and_connect(dev)
    elif action == "scan":
        notify("Scanning for Bluetooth devices...", "Looking for nearby devices (5s)")
        run_cmd(["bluetoothctl", "--timeout", "5", "scan", "on"], timeout=8.0)
        show_menu(output, show_discovered=True)
    elif action == "manage":
        show_manage_paired(output, payload, show_discovered)
    elif action == "discoverable_on":
        res = run_cmd(["bluetoothctl", "discoverable", "on"], timeout=5.0)
        if res.returncode == 0:
            notify("Bluetooth discoverable", "Visible to nearby devices")
        else:
            notify("Failed to enable discoverable", bt_error(res, "Error"), "critical")
    elif action == "discoverable_off":
        res = run_cmd(["bluetoothctl", "discoverable", "off"], timeout=5.0)
        if res.returncode == 0:
            notify("Bluetooth hidden", "No longer discoverable")
        else:
            notify("Failed to disable discoverable", bt_error(res, "Error"), "critical")


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--toggle-power":
        return toggle_power()

    if kill_pidfile(PID_FILE):
        return 0
    for other in OTHER_PID_FILES:
        kill_pidfile(other)

    output = detect_cursor_output()
    show_menu(output, show_discovered=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
