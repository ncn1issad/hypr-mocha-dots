#!/usr/bin/env python3
"""Waybar custom/external-backlight module using DDC/CI (ddcutil)."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE_FILE = RUNTIME_DIR / "waybar-external-backlight.json"
STATE_LOCK = RUNTIME_DIR / "waybar-external-backlight.state.lock"
DDC_LOCK = RUNTIME_DIR / "waybar-external-backlight.ddc.lock"

WAYBAR_SIGNAL = "RTMIN+9"
MONITOR_ICON = "󰍹"
INTERNAL_PREFIXES = ("eDP-", "LVDS-", "DSI-")
DEBOUNCE_SECONDS = 0.12
RECENT_ADJUST_GRACE = 3.0
INCOMPATIBLE_RETRY_SECONDS = 60.0
SLEEP_MULTIPLIER = ".2"


def run_cmd(args: list[str], timeout: float = 10.0) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return subprocess.CompletedProcess(args, 1, "", "")


def signal_waybar() -> None:
    run_cmd(["pkill", f"-{WAYBAR_SIGNAL}", "waybar"], timeout=2.0)


@contextmanager
def file_lock(path: Path, blocking: bool = True) -> Iterator[bool]:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_CREAT | os.O_RDWR, 0o600)
    flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
    acquired = False
    try:
        try:
            fcntl.flock(fd, flags)
            acquired = True
        except BlockingIOError:
            acquired = False
        yield acquired
    finally:
        if acquired:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(fd)


def short_connector(drm_connector: str) -> str:
    return re.sub(r"^card\d+-", "", drm_connector)


def is_internal_connector(drm_connector: str) -> bool:
    return short_connector(drm_connector).startswith(INTERNAL_PREFIXES)


def get_external_drm_fingerprint() -> list[list[str]]:
    """Return sorted [drm_connector, edid_sha1] pairs for connected external outputs."""
    drm_root = Path("/sys/class/drm")
    if not drm_root.exists():
        return []

    found: list[list[str]] = []
    for entry in sorted(drm_root.iterdir()):
        name = entry.name
        if not re.match(r"^card\d+-", name):
            continue
        if is_internal_connector(name):
            continue
        status_file = entry / "status"
        try:
            if status_file.read_text(encoding="utf-8", errors="ignore").strip() != "connected":
                continue
        except OSError:
            continue

        edid_hash = ""
        try:
            edid_bytes = (entry / "edid").read_bytes()
            if edid_bytes:
                edid_hash = hashlib.sha1(edid_bytes).hexdigest()[:16]
        except OSError:
            pass
        found.append([name, edid_hash])

    found.sort()
    return found


def read_state() -> dict[str, Any]:
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            return data
    except (OSError, ValueError):
        pass
    return {}


def write_state(state: dict[str, Any]) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(f".json.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(state), encoding="utf-8")
    os.replace(tmp, STATE_FILE)


def parse_detect_terse(text: str) -> list[dict[str, Any]]:
    displays: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None

    for raw_line in text.splitlines():
        if re.match(r"^Display\s+\d+\s*$", raw_line):
            if current is not None:
                displays.append(current)
            current = {}
            continue
        if raw_line.startswith("Invalid display"):
            if current is not None:
                displays.append(current)
                current = None
            continue
        if current is None:
            continue

        stripped = raw_line.strip()
        if not stripped or ":" not in stripped:
            continue
        key, val = stripped.split(":", 1)
        key = key.strip().lower()
        val = val.strip()

        if key == "i2c bus":
            match = re.search(r"/dev/i2c-(\d+)", val)
            if match:
                current["bus"] = int(match.group(1))
        elif key in ("drm connector", "drm_connector"):
            current["connector"] = val
        elif key == "monitor":
            parts = val.split(":", 2)
            mfg = parts[0].strip() if len(parts) > 0 else ""
            model = parts[1].strip() if len(parts) > 1 else ""
            current["model"] = model or mfg

    if current is not None:
        displays.append(current)

    valid: list[dict[str, Any]] = []
    seen_buses: set[int] = set()
    for disp in displays:
        bus = disp.get("bus")
        if not isinstance(bus, int) or bus in seen_buses:
            continue
        connector = str(disp.get("connector", "") or "")
        if connector and is_internal_connector(connector):
            continue
        seen_buses.add(bus)
        model = str(disp.get("model", "") or "").strip() or (
            short_connector(connector) if connector else f"Display (i2c-{bus})"
        )
        valid.append(
            {
                "bus": bus,
                "connector": connector,
                "model": model,
            }
        )
    return valid


def ddc_get_brightness(bus: int) -> tuple[int, int] | None:
    res = run_cmd(
        [
            "ddcutil",
            "--bus",
            str(bus),
            "--sleep-multiplier",
            SLEEP_MULTIPLIER,
            "getvcp",
            "10",
            "--terse",
        ],
        timeout=6.0,
    )
    if res.returncode != 0:
        return None
    for line in res.stdout.splitlines():
        match = re.match(r"^VCP\s+10\s+C\s+(\d+)\s+(\d+)\b", line.strip())
        if match:
            cur, max_val = int(match.group(1)), int(match.group(2))
            if max_val > 0:
                return cur, max_val
    return None


def ddc_set_brightness(bus: int, raw_value: int) -> bool:
    res = run_cmd(
        [
            "ddcutil",
            "--bus",
            str(bus),
            "--sleep-multiplier",
            SLEEP_MULTIPLIER,
            "--noverify",
            "setvcp",
            "10",
            str(raw_value),
        ],
        timeout=6.0,
    )
    return res.returncode == 0


def probe_compatible_monitors() -> list[dict[str, Any]]:
    res = run_cmd(["ddcutil", "detect", "--terse"], timeout=10.0)
    if res.returncode != 0:
        return []

    monitors: list[dict[str, Any]] = []
    for disp in parse_detect_terse(res.stdout):
        reading = ddc_get_brightness(disp["bus"])
        if reading is None:
            continue
        cur, max_val = reading
        pct = max(0, min(100, int(round(cur * 100 / max_val))))
        monitors.append(
            {
                "bus": disp["bus"],
                "connector": disp["connector"],
                "model": disp["model"],
                "current": cur,
                "max_val": max_val,
                "pct": pct,
                "target_pct": pct,
                "applied_pct": pct,
                "fail_count": 0,
            }
        )
    return monitors


def make_state(fingerprint: list[list[str]], monitors: list[dict[str, Any]]) -> dict[str, Any]:
    now = time.time()
    return {
        "fingerprint": fingerprint,
        "monitors": monitors,
        "pending": False,
        "updated_at": now,
        "next_probe_at": now + INCOMPATIBLE_RETRY_SECONDS if (fingerprint and not monitors) else 0.0,
    }


def render_waybar(state: dict[str, Any]) -> None:
    monitors = state.get("monitors") or []
    if not monitors:
        print(json.dumps({"text": ""}))
        return

    primary = monitors[0]
    pct = int(primary.get("pct", 0))
    text = f"{MONITOR_ICON} {pct}%"

    tooltip_lines: list[str] = []
    if len(monitors) == 1:
        model = str(primary.get("model", "External Monitor"))
        conn = short_connector(str(primary.get("connector", "")))
        tooltip_lines.append(
            f"<b><span color='#cdd6f4'>{html.escape(model)} · {pct}%</span></b>"
        )
        meta = f"{conn} · DDC/CI" if conn else "DDC/CI"
        tooltip_lines.append(f"<span color='#a6adc8'>{html.escape(meta)}</span>")
    else:
        for idx, mon in enumerate(monitors):
            model = str(mon.get("model", "External Monitor"))
            conn = short_connector(str(mon.get("connector", "")))
            mpct = int(mon.get("pct", 0))
            label = f"{model} ({conn})" if conn else model
            if idx == 0:
                tooltip_lines.append(
                    f"<b><span color='#cdd6f4'>{html.escape(label)} · {mpct}%</span></b>"
                )
            else:
                tooltip_lines.append(
                    f"<span color='#cdd6f4'>{html.escape(label)} · {mpct}%</span>"
                )

    tooltip_lines.append("<span color='#7f849c'>Scroll: Adjust brightness</span>")
    print(
        json.dumps(
            {
                "text": text,
                "tooltip": "\n".join(tooltip_lines),
                "percentage": pct,
            }
        )
    )


def cmd_status() -> int:
    fingerprint = get_external_drm_fingerprint()
    if not fingerprint:
        with file_lock(STATE_LOCK):
            if read_state().get("monitors") or read_state().get("fingerprint"):
                write_state(make_state([], []))
        print(json.dumps({"text": ""}))
        return 0

    with file_lock(STATE_LOCK):
        state = read_state()

    now = time.time()
    same_fp = state.get("fingerprint") == fingerprint
    monitors = state.get("monitors") if same_fp else None

    if same_fp:
        if state.get("pending") or (now - float(state.get("updated_at", 0.0)) < RECENT_ADJUST_GRACE):
            render_waybar(state)
            return 0
        if not monitors:
            if now < float(state.get("next_probe_at", 0.0)):
                print(json.dumps({"text": ""}))
                return 0
        else:
            # Periodic refresh from hardware OSD if I2C bus is idle.
            with file_lock(DDC_LOCK, blocking=False) as got_ddc:
                if not got_ddc:
                    render_waybar(state)
                    return 0

                need_redetect = False
                refreshed: list[dict[str, Any]] = []
                for mon in monitors:
                    updated = dict(mon)
                    reading = ddc_get_brightness(int(mon["bus"]))
                    if reading is not None:
                        cur, max_val = reading
                        pct = max(0, min(100, int(round(cur * 100 / max_val))))
                        updated["current"] = cur
                        updated["max_val"] = max_val
                        updated["pct"] = pct
                        updated["target_pct"] = pct
                        updated["applied_pct"] = pct
                        updated["fail_count"] = 0
                    else:
                        updated["fail_count"] = int(mon.get("fail_count", 0)) + 1
                        if updated["fail_count"] >= 2:
                            need_redetect = True
                    refreshed.append(updated)

                if need_redetect:
                    refreshed = probe_compatible_monitors()
                    new_state = make_state(fingerprint, refreshed)
                else:
                    new_state = {
                        "fingerprint": fingerprint,
                        "monitors": refreshed,
                        "pending": False,
                        "updated_at": time.time(),
                        "next_probe_at": 0.0,
                    }

                with file_lock(STATE_LOCK):
                    latest = read_state()
                    # Do not clobber a scroll adjustment that started during getvcp.
                    if latest.get("pending") and latest.get("fingerprint") == fingerprint:
                        state = latest
                    else:
                        write_state(new_state)
                        state = new_state

                render_waybar(state)
                return 0

    # Fingerprint changed or incompatible retry window elapsed: probe under DDC lock.
    with file_lock(DDC_LOCK, blocking=True):
        # Re-check state in case another instance just probed.
        with file_lock(STATE_LOCK):
            latest = read_state()
        if (
            latest.get("fingerprint") == fingerprint
            and (latest.get("monitors") or time.time() < float(latest.get("next_probe_at", 0.0)))
        ):
            render_waybar(latest)
            return 0

        found = probe_compatible_monitors()
        new_state = make_state(fingerprint, found)
        with file_lock(STATE_LOCK):
            write_state(new_state)
        render_waybar(new_state)
        return 0


def cmd_adjust(delta: int) -> int:
    fingerprint = get_external_drm_fingerprint()
    if not fingerprint:
        return 0

    with file_lock(STATE_LOCK):
        state = read_state()
        if state.get("fingerprint") != fingerprint or not state.get("monitors"):
            need_probe = True
        else:
            need_probe = False

    if need_probe:
        with file_lock(DDC_LOCK, blocking=True):
            found = probe_compatible_monitors()
            new_state = make_state(fingerprint, found)
            with file_lock(STATE_LOCK):
                write_state(new_state)
        if not found:
            return 0

    changed = False
    with file_lock(STATE_LOCK):
        state = read_state()
        monitors = state.get("monitors") or []
        if not monitors:
            return 0
        for mon in monitors:
            cur_pct = int(mon.get("pct", 50))
            new_pct = max(0, min(100, cur_pct + delta))
            if new_pct != cur_pct or mon.get("target_pct") != new_pct:
                changed = True
            mon["pct"] = new_pct
            mon["target_pct"] = new_pct
        state["pending"] = True
        state["updated_at"] = time.time()
        write_state(state)

    if changed:
        signal_waybar()

    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--apply"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return 0


def cmd_apply() -> int:
    with file_lock(DDC_LOCK, blocking=False) as got_ddc:
        if not got_ddc:
            return 0

        while True:
            time.sleep(DEBOUNCE_SECONDS)
            tasks: list[tuple[int, int, int]] = []
            with file_lock(STATE_LOCK):
                state = read_state()
                monitors = state.get("monitors") or []
                for mon in monitors:
                    target_pct = int(mon.get("target_pct", mon.get("pct", 50)))
                    applied_pct = mon.get("applied_pct")
                    if applied_pct != target_pct:
                        tasks.append(
                            (
                                int(mon["bus"]),
                                target_pct,
                                max(1, int(mon.get("max_val", 100))),
                            )
                        )
                if not tasks:
                    if state.get("pending"):
                        state["pending"] = False
                        state["updated_at"] = time.time()
                        write_state(state)
                    return 0

            for bus, target_pct, max_val in tasks:
                raw_val = max(0, min(max_val, int(round(target_pct * max_val / 100))))
                ok = ddc_set_brightness(bus, raw_val)
                with file_lock(STATE_LOCK):
                    state = read_state()
                    for mon in state.get("monitors") or []:
                        if int(mon.get("bus", -1)) == bus:
                            mon["applied_pct"] = target_pct
                            if ok:
                                mon["current"] = raw_val
                                mon["fail_count"] = 0
                    state["updated_at"] = time.time()
                    write_state(state)


def cmd_refresh() -> int:
    with file_lock(DDC_LOCK, blocking=True):
        fingerprint = get_external_drm_fingerprint()
        if not fingerprint:
            with file_lock(STATE_LOCK):
                write_state(make_state([], []))
            signal_waybar()
            return 0

        found: list[dict[str, Any]] = []
        # Monitors often take 1-3s after hotplug before DDC/CI starts responding.
        for attempt in range(3):
            if attempt > 0:
                time.sleep(1.5)
                fingerprint = get_external_drm_fingerprint()
                if not fingerprint:
                    break
            found = probe_compatible_monitors()
            if found:
                break

        with file_lock(STATE_LOCK):
            write_state(make_state(fingerprint, found))
        signal_waybar()
        return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Waybar DDC/CI external monitor brightness module")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--status", action="store_true", help="Output Waybar JSON (default)")
    group.add_argument("--adjust", type=int, metavar="DELTA", help="Adjust brightness by DELTA percent")
    group.add_argument("--apply", action="store_true", help="Internal debounced DDC/CI writer")
    group.add_argument("--refresh", action="store_true", help="Re-probe monitors on hotplug and notify Waybar")
    args = parser.parse_args()

    if args.adjust is not None:
        return cmd_adjust(args.adjust)
    if args.apply:
        return cmd_apply()
    if args.refresh:
        return cmd_refresh()
    return cmd_status()


if __name__ == "__main__":
    sys.exit(main())
