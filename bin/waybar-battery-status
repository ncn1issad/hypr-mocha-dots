#!/usr/bin/env python3
"""Waybar custom/battery module with peripheral battery percentages in tooltip."""

from __future__ import annotations

import html
import json
import re
import subprocess
import sys

BATTERY_ICONS = ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]

PROFILE_LABELS = {
    "power-saver": "Power Saver",
    "balanced": "Balanced",
    "performance": "Performance",
}


def run_cmd(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, capture_output=True, check=False)


def parse_upower_dump(text: str) -> list[dict[str, str]]:
    """Parse `upower --dump` output into a list of device dicts."""
    devices: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    in_history = False

    for raw_line in text.splitlines():
        if raw_line.startswith("Device: "):
            if current is not None:
                devices.append(current)
            current = {"path": raw_line[len("Device: ") :].strip()}
            in_history = False
            continue
        if raw_line.startswith("Daemon:"):
            if current is not None:
                devices.append(current)
                current = None
            in_history = False
            continue
        if current is None:
            continue

        stripped = raw_line.strip()
        if not stripped:
            continue
        if stripped.startswith("History ("):
            in_history = True
            continue
        if in_history:
            if raw_line.startswith("    "):
                continue
            in_history = False

        if ":" in stripped:
            key, val = stripped.split(":", 1)
            key = key.strip()
            val = val.strip().strip("'\"")
            if key not in current:
                current[key] = val
        elif raw_line.startswith("  ") and not raw_line.startswith("    "):
            current["kind"] = stripped

    if current is not None:
        devices.append(current)
    return devices


def parse_float(val: str | None) -> float | None:
    if not val:
        return None
    match = re.search(r"[-+]?\d+(?:\.\d+)?", val)
    if not match:
        return None
    try:
        return float(match.group(0))
    except ValueError:
        return None


def battery_icon(pct: int) -> str:
    idx = min(len(BATTERY_ICONS) - 1, max(0, pct * len(BATTERY_ICONS) // 101))
    return BATTERY_ICONS[idx]


def peripheral_icon(dev: dict[str, str]) -> str:
    haystack = " ".join(
        dev.get(k, "")
        for k in ("kind", "path", "icon-name", "model", "native-path")
    ).lower()
    if "mouse" in haystack:
        return "󰍽"
    if "keyboard" in haystack:
        return "󰌌"
    if "headset" in haystack:
        return "󰋎"
    if "headphone" in haystack or "earbud" in haystack or "airpod" in haystack:
        return "󰋋"
    if "gaming" in haystack or "gamepad" in haystack or "controller" in haystack or "joystick" in haystack:
        return "󰊴"
    if "phone" in haystack:
        return "󰏲"
    if "tablet" in haystack:
        return "󰓶"
    if "stylus" in haystack or "pen" in haystack:
        return "󰏫"
    if "speaker" in haystack:
        return "󰓃"
    return "󰁹"


def peripheral_name(dev: dict[str, str]) -> str:
    model = dev.get("model", "").strip()
    if model:
        return model
    vendor = dev.get("vendor", "").strip()
    kind = dev.get("kind", "").strip().replace("-", " ").title()
    if vendor and kind:
        return f"{vendor} {kind}"
    if kind:
        return kind
    native = dev.get("native-path", "").strip()
    return native or "Device"


def get_power_profile() -> str | None:
    res = run_cmd(["powerprofilesctl", "get"])
    if res.returncode != 0:
        return None
    raw = res.stdout.strip()
    if not raw:
        return None
    return PROFILE_LABELS.get(raw, raw.replace("-", " ").title())


def main() -> int:
    res = run_cmd(["upower", "--dump"])
    if res.returncode != 0:
        print(json.dumps({"text": "", "tooltip": "UPower unavailable"}))
        return 0

    devices = parse_upower_dump(res.stdout)

    # Identify primary system battery (prefer real power-supply battery, fallback to DisplayDevice).
    primary: dict[str, str] | None = None
    display_dev: dict[str, str] | None = None
    for dev in devices:
        path = dev.get("path", "")
        if path.endswith("/DisplayDevice"):
            display_dev = dev
            continue
        if dev.get("kind") == "line-power":
            continue
        if dev.get("power supply") == "yes" and dev.get("percentage") and dev.get("present") != "no":
            primary = dev
            break

    if primary is None:
        primary = display_dev

    # Collect other detected batteries (peripherals or secondary batteries).
    primary_path = primary.get("path", "") if primary else ""
    others: list[tuple[str, str, int]] = []
    for dev in devices:
        path = dev.get("path", "")
        if not path or path == primary_path or path.endswith("/DisplayDevice"):
            continue
        if dev.get("kind") == "line-power":
            continue
        if dev.get("present") == "no":
            continue
        pct_val = parse_float(dev.get("percentage"))
        if pct_val is None:
            continue
        others.append((peripheral_icon(dev), peripheral_name(dev), int(round(pct_val))))

    if primary is None or parse_float(primary.get("percentage")) is None:
        if others:
            icon, name, pct = others[0]
            lines = [f"{ic}  {html.escape(nm)} · {p}%" for ic, nm, p in others]
            print(json.dumps({"text": f"{icon} {pct}%", "tooltip": "\n".join(lines)}))
        else:
            print(json.dumps({"text": ""}))
        return 0

    pct = int(round(parse_float(primary.get("percentage")) or 0))
    state = primary.get("state", "").lower()
    rate = parse_float(primary.get("energy-rate"))
    health = parse_float(primary.get("capacity"))
    time_empty = primary.get("time to empty", "").strip()
    time_full = primary.get("time to full", "").strip()

    classes: list[str] = []
    if state == "charging":
        text = f"󰂄 {pct}%"
        classes.append("charging")
        status_text = f"Charging ({time_full} to full)" if time_full else "Charging"
    elif state in ("fully-charged", "pending-charge"):
        text = f"󰚥 {pct}%"
        classes.append("plugged")
        status_text = "Full" if state == "fully-charged" else "Plugged in"
    else:
        text = f"{battery_icon(pct)} {pct}%"
        if pct <= 10:
            classes.append("critical")
        elif pct <= 25:
            classes.append("warning")
        status_text = f"{time_empty} left" if time_empty else "Discharging"

    # Build clean Catppuccin Pango tooltip.
    header_parts = [f"{pct}%", status_text]
    if rate is not None and rate > 0.05:
        header_parts.append(f"{rate:.1f}W")

    tooltip_lines = [f"<b><span color='#cdd6f4'>{' · '.join(html.escape(p) for p in header_parts)}</span></b>"]

    meta_parts: list[str] = []
    if health is not None:
        meta_parts.append(f"Health {int(round(health))}%")
    profile = get_power_profile()
    if profile:
        meta_parts.append(profile)
    if meta_parts:
        tooltip_lines.append(f"<span color='#a6adc8'>{' · '.join(html.escape(p) for p in meta_parts)}</span>")

    if others:
        tooltip_lines.append("<span color='#45475a'>────────────────────</span>")
        for ic, nm, p in others:
            tooltip_lines.append(f"<span color='#cdd6f4'>{ic}  {html.escape(nm)} · {p}%</span>")

    tooltip_lines.append("<span color='#7f849c'>Left: Power profile</span>")

    print(
        json.dumps(
            {
                "text": text,
                "tooltip": "\n".join(tooltip_lines),
                "class": classes,
            }
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
