#!/usr/bin/bash
set -euo pipefail

wallpapers="${WALLPAPERS_DIR:-$HOME/Pictures/Wallpapers/Catppuccin Mocha}"
awww="${AWWW_BIN:-$HOME/.local/bin/awww}"
greeter_cache="${GREETER_CACHE:-/var/cache/sddm-desktop-wallpaper}"
fallback=/usr/share/sddm/themes/catppuccin-mocha-lavender/backgrounds/wall.png

list_images() {
    find "$wallpapers" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) -print0
}

current_wallpaper() {
    local line
    while IFS= read -r line; do
        if [[ $line =~ currently\ displaying:\ (image|animation):\ (.+)$ ]] && [[ -r ${BASH_REMATCH[2]} ]]; then
            printf '%s\n' "${BASH_REMATCH[2]}"
            return
        fi
    done <<< "$1"
    return 1
}

publish_wallpaper() {
    local image=$1 temporary
    [[ $image == "$wallpapers/"* ]] || return 0
    [[ -d $greeter_cache ]] || return 0
    temporary=$(mktemp "$greeter_cache/.current.XXXXXXXX") || return 1
    if cp -- "$image" "$temporary" && chmod 0640 "$temporary" && mv -fT -- "$temporary" "$greeter_cache/current"; then
        return
    fi
    rm -f -- "$temporary"
    return 1
}

rotate_wallpaper() {
    local outputs=$1
    local -a images=() choices=()
    local current_paths image wallpaper

    mapfile -d '' -t images < <(list_images)
    if (( ${#images[@]} == 0 )); then
        echo "No images found in $wallpapers." >&2
        return 1
    fi

    current_paths=$(sed -nE 's/^.*currently displaying: (image|animation): //p' <<< "$outputs")
    for image in "${images[@]}"; do
        if ! grep -Fxq -- "$image" <<< "$current_paths"; then
            choices+=("$image")
        fi
    done
    if (( ${#choices[@]} == 0 )); then
        choices=("${images[@]}")
    fi

    IFS= read -r -d '' wallpaper < <(printf '%s\0' "${choices[@]}" | shuf -z -n 1)
    "$awww" img "$wallpaper"
    publish_wallpaper "$wallpaper"
}

remove_wallpaper() {
    local outputs=$1 target=$2
    local wallpapers_real target_real current_paths path path_real
    local -a images=()
    local is_displayed=0

    if ! wallpapers_real=$(realpath -e -- "$wallpapers" 2>/dev/null); then
        echo "Wallpapers folder not found: $wallpapers" >&2
        return 1
    fi
    if ! target_real=$(realpath -e -- "$target" 2>/dev/null); then
        echo "Wallpaper file no longer exists." >&2
        return 1
    fi
    if [[ ! -f $target_real || $target_real != "$wallpapers_real/"* ]]; then
        echo "Refusing to remove file outside $wallpapers." >&2
        return 1
    fi

    mapfile -d '' -t images < <(list_images)
    if (( ${#images[@]} <= 1 )); then
        echo "Cannot remove the last remaining wallpaper." >&2
        return 1
    fi

    current_paths=$(sed -nE 's/^.*currently displaying: (image|animation): //p' <<< "$outputs")
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        path_real=$(realpath -m -- "$path" 2>/dev/null || printf '%s' "$path")
        if [[ $path == "$target" || $path_real == "$target_real" ]]; then
            is_displayed=1
            break
        fi
    done <<< "$current_paths"

    rm -- "$target_real"

    if (( is_displayed )); then
        rotate_wallpaper "$outputs"
    fi

    printf '%s\n' "$target_real"
}

if [[ ${1:-} == --current ]]; then
    if ! current_wallpaper "$("$awww" query 2>/dev/null || true)"; then
        printf '%s\n' "$fallback"
    fi
    exit
fi

exec 9>"${XDG_RUNTIME_DIR:?Missing Wayland runtime directory}/catppuccin-wallpaper.lock"
flock 9

for ((attempt = 0; attempt < 30; attempt++)); do
    if outputs=$("$awww" query 2>/dev/null) && [[ -n $outputs ]]; then
        break
    fi
    sleep 1
done
if [[ -z $outputs ]]; then
    echo "awww is unavailable in this Wayland session." >&2
    exit 1
fi

if [[ ${1:-} == --publish-current ]]; then
    wallpaper=$(current_wallpaper "$outputs")
    publish_wallpaper "$wallpaper"
    exit
fi

if [[ ${1:-} == --sync-output ]]; then
    output=${2:?Missing output name}
    for ((attempt = 0; attempt < 10; attempt++)); do
        outputs=$("$awww" query)
        if grep -Fq -- ": $output: " <<< "$outputs"; then
            while IFS= read -r line; do
                [[ $line == ": $output: "* ]] && continue
                if [[ $line =~ currently\ displaying:\ (image|animation):\ (.+)$ ]]; then
                    wallpaper=${BASH_REMATCH[2]}
                    if [[ -f $wallpaper ]]; then
                        "$awww" img "$wallpaper" --outputs "$output" --transition-type none
                        exit
                    fi
                fi
            done <<< "$outputs"
        fi
        sleep 0.5
    done
    exit 0
fi

if [[ ${1:-} == --remove ]]; then
    target=${2:?Missing wallpaper path}
    remove_wallpaper "$outputs" "$target"
    exit
fi

if [[ ${1:-} == --remove-current ]]; then
    if ! wallpaper=$(current_wallpaper "$outputs"); then
        echo "No active wallpaper found." >&2
        exit 1
    fi
    remove_wallpaper "$outputs" "$wallpaper"
    exit
fi

rotate_wallpaper "$outputs"
