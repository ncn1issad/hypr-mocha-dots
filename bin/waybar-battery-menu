#!/usr/bin/env python3
"""Minimal Catppuccin fuzzel power-profile switcher for Waybar's battery module."""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
from pathlib import Path

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PID_FILE = RUNTIME_DIR / "waybar-battery-menu.pid"
OTHER_PID_FILES = [
    RUNTIME_DIR / "waybar-network-menu.pid",
    RUNTIME_DIR / "waybar-power-menu.pid",
    RUNTIME_DIR / "waybar-output-menu.pid",
    RUNTIME_DIR / "waybar-input-menu.pid",
    RUNTIME_DIR / "waybar-bluetooth-menu.pid",
]

PROFILE_META = {
    "power-saver": ("󰌪", "Power Saver"),
    "balanced": ("󰾅", "Balanced"),
    "performance": ("󰓅", "Performance"),
}
PROFILE_ORDER = ["power-saver", "balanced", "performance"]


def run_cmd(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, capture_output=True, check=False)


def notify(summary: str, body: str = "", urgency: str = "low") -> None:
    cmd = [
        "notify-send",
        "-a",
        "Power",
        "-u",
        urgency,
        "-h",
        "string:x-canonical-private-synchronous:waybar-power-profile",
        summary,
    ]
    if body:
        cmd.append(body)
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kill_pidfile(path: Path) -> bool:
    if not path.exists():
        return False
    try:
        pid = int(path.read_text().strip())
    except ValueError:
        path.unlink(missing_ok=True)
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
        if b"fuzzel" in cmdline:
            os.kill(pid, signal.SIGTERM)
            path.unlink(missing_ok=True)
            return True
    except OSError:
        pass
    path.unlink(missing_ok=True)
    return False


def detect_cursor_output() -> str | None:
    pos_res = run_cmd(["hyprctl", "cursorpos", "-j"])
    mon_res = run_cmd(["hyprctl", "monitors", "-j"])
    if pos_res.returncode != 0 or mon_res.returncode != 0:
        return None
    try:
        pos = json.loads(pos_res.stdout)
        monitors = json.loads(mon_res.stdout)
        cx, cy = float(pos["x"]), float(pos["y"])
        for mon in monitors:
            scale = float(mon.get("scale", 1) or 1)
            transform = int(mon.get("transform", 0) or 0)
            w = float(mon["width"]) / scale
            h = float(mon["height"]) / scale
            if transform in (1, 3, 5, 7):
                w, h = h, w
            mx, my = float(mon["x"]), float(mon["y"])
            if mx <= cx < mx + w and my <= cy < my + h:
                return str(mon["name"])
    except (ValueError, KeyError, TypeError):
        return None
    return None


def list_profiles() -> tuple[str, list[str]]:
    active = run_cmd(["powerprofilesctl", "get"]).stdout.strip()
    res = run_cmd(["powerprofilesctl", "list"])
    if res.returncode != 0:
        return active, []

    found: list[str] = []
    for line in res.stdout.splitlines():
        match = re.match(r"^[\s*]+([a-z0-9-]+):\s*$", line)
        if match:
            name = match.group(1)
            if name not in found:
                found.append(name)

    order_map = {name: i for i, name in enumerate(PROFILE_ORDER)}
    found.sort(key=lambda name: (order_map.get(name, len(PROFILE_ORDER)), name))
    return active, found


def run_fuzzel(entries: list[tuple[str, object]], output: str | None) -> object | None:
    cmd = [
        "fuzzel",
        "--dmenu",
        "--index",
        "--minimal-lines",
        f"--lines={min(8, max(1, len(entries)))}",
        "--anchor=top-right",
        "--x-margin=10",
        "--y-margin=10",
        "--width=24",
        "--prompt=󰁹  ",
        "--placeholder=Power profile...",
    ]
    if output:
        cmd.append(f"--output={output}")

    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    PID_FILE.write_text(str(proc.pid))
    try:
        stdout, _ = proc.communicate("\n".join(label for label, _ in entries))
    finally:
        try:
            if PID_FILE.exists() and PID_FILE.read_text().strip() == str(proc.pid):
                PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass

    if proc.returncode != 0:
        return None
    try:
        return entries[int(stdout.strip())][1]
    except (ValueError, IndexError):
        return None


def main() -> int:
    if kill_pidfile(PID_FILE):
        return 0
    for other in OTHER_PID_FILES:
        kill_pidfile(other)

    output = detect_cursor_output()
    active, profiles = list_profiles()

    entries: list[tuple[str, object]] = []
    for prof in profiles:
        icon, label = PROFILE_META.get(prof, ("󰚥", prof.replace("-", " ").title()))
        mark = "  󰄬" if prof == active else ""
        entries.append((f"{icon}  {label}{mark}", (prof, label)))

    if not entries:
        entries.append(("󰂑  No power profiles available", None))

    selected = run_fuzzel(entries, output)
    if not isinstance(selected, tuple):
        return 0

    prof, label = selected
    res = run_cmd(["powerprofilesctl", "set", str(prof)])
    if res.returncode == 0:
        run_cmd(["pkill", "-RTMIN+8", "waybar"])
        notify("Power Profile", str(label))
    else:
        notify("Failed to set power profile", res.stderr.strip(), "critical")
    return 0


if __name__ == "__main__":
    sys.exit(main())
