import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
LOCK_FILE = RUNTIME_DIR / "desktop-context-menu.lock"
PID_FILE = RUNTIME_DIR / "desktop-context-menu.pid"

ROTATE_SCRIPT = Path.home() / ".local/bin/rotate-catppuccin-wallpaper"
WALLPAPERS_DIR = Path(
    os.environ.get(
        "WALLPAPERS_DIR",
        str(Path.home() / "Pictures/Wallpapers/Catppuccin Mocha"),
