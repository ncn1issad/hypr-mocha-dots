#!/usr/bin/bash
set -euo pipefail

status=$(/usr/bin/playerctl status 2>/dev/null) || exit 0
[[ $status == Playing || $status == Paused ]] || exit 0

case "${1:-}" in
    track)
        metadata=$(/usr/bin/playerctl metadata --format '{{title}} — {{artist}}' 2>/dev/null) || exit 0
        metadata=${metadata% — }
        metadata=${metadata# — }
        metadata=${metadata//$'\n'/ }
        metadata=${metadata//$'\r'/ }
        if (( ${#metadata} > 44 )); then
            metadata="${metadata:0:43}…"
        fi
        printf '%s' "$metadata" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
        ;;
    previous) printf '%s' '⏮' ;;
    toggle)
        if [[ $status == Playing ]]; then
            printf '%s' '⏸'
        else
            printf '%s' '▶'
        fi
        ;;
    next) printf '%s' '⏭' ;;
esac
