#!/usr/bin/env python3
"""Minimal Wayland screenshot utility with Fuzzel menu for Hyprland."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import signal
import struct
import subprocess
import sys
import time
from pathlib import Path

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PID_FILE = RUNTIME_DIR / "screenshot-menu.pid"
SLURP_PID_FILE = RUNTIME_DIR / "screenshot-slurp.pid"
PREVIEW_FILE = RUNTIME_DIR / "screenshot-preview.png"
OTHER_PID_FILES = [
    RUNTIME_DIR / "waybar-network-menu.pid",
    RUNTIME_DIR / "waybar-power-menu.pid",
    RUNTIME_DIR / "waybar-output-menu.pid",
    RUNTIME_DIR / "waybar-input-menu.pid",
    RUNTIME_DIR / "waybar-battery-menu.pid",
    RUNTIME_DIR / "waybar-bluetooth-menu.pid",
]

DEFAULT_SAVE_DIR = Path(
    os.environ.get(
        "SCREENSHOTS_DIR",
        str(Path.home() / "Pictures/Screenshots"),
    )
)

# Catppuccin Mocha (Lavender) slurp styling — overridable via environment variables
SLURP_BG = os.environ.get("SCREENSHOT_SLURP_BG", "#1e1e2e88")
SLURP_BORDER = os.environ.get("SCREENSHOT_SLURP_BORDER", "#b4befeff")
SLURP_SELECTION = os.environ.get("SCREENSHOT_SLURP_SELECTION", "#31324433")
SLURP_BOX = os.environ.get("SCREENSHOT_SLURP_BOX", "#1e1e2edd")
SLURP_FONT = os.environ.get("SCREENSHOT_SLURP_FONT", "JetBrains Mono")

MODE_LABELS = {
    "region": "Region",
    "window": "Window",
    "active-window": "Active window",
    "monitor": "Current monitor",
    "all": "All monitors",
}


def run_cmd(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, capture_output=True, check=False)


def notify(
    summary: str,
    body: str = "",
    icon: str | None = None,
    urgency: str = "low",
) -> None:
    cmd = [
        "notify-send",
        "-a",
        "Screenshot",
        "-u",
        urgency,
        "-h",
        "string:x-canonical-private-synchronous:screenshot",
    ]
    if icon:
        cmd.extend(["-i", icon])
    cmd.append(summary)
    if body:
        cmd.append(body)
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kill_pidfile(path: Path, expected_cmd: bytes = b"fuzzel") -> bool:
    if not path.exists():
        return False
    try:
        pid = int(path.read_text().strip())
    except ValueError:
        path.unlink(missing_ok=True)
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
        if expected_cmd in cmdline:
            os.kill(pid, signal.SIGTERM)
            path.unlink(missing_ok=True)
            return True
    except OSError:
        pass
    path.unlink(missing_ok=True)
    return False


def get_monitors() -> list[dict[str, object]]:
    res = run_cmd(["hyprctl", "monitors", "-j"])
    if res.returncode != 0:
        return []
    try:
        data = json.loads(res.stdout)
        return data if isinstance(data, list) else []
    except ValueError:
        return []


def detect_cursor_output(monitors: list[dict[str, object]] | None = None) -> str | None:
    if monitors is None:
        monitors = get_monitors()
    if not monitors:
        return None

    pos_res = run_cmd(["hyprctl", "cursorpos", "-j"])
    if pos_res.returncode == 0:
        try:
            pos = json.loads(pos_res.stdout)
            cx, cy = float(pos["x"]), float(pos["y"])
            for mon in monitors:
                scale = float(mon.get("scale", 1) or 1)
                transform = int(mon.get("transform", 0) or 0)
                w = float(mon["width"]) / scale
                h = float(mon["height"]) / scale
                if transform in (1, 3, 5, 7):
                    w, h = h, w
                mx, my = float(mon["x"]), float(mon["y"])
                if mx <= cx < mx + w and my <= cy < my + h:
                    return str(mon["name"])
        except (ValueError, KeyError, TypeError):
            pass

    for mon in monitors:
        if mon.get("focused"):
            return str(mon["name"])
    return str(monitors[0]["name"]) if monitors[0].get("name") else None


def list_visible_window_geometries() -> list[str]:
    monitors = get_monitors()
    active_workspaces: set[int] = set()
    for mon in monitors:
        ws = mon.get("activeWorkspace")
        if isinstance(ws, dict) and isinstance(ws.get("id"), int):
            active_workspaces.add(ws["id"])
        special = mon.get("specialWorkspace")
        if isinstance(special, dict):
            sid = special.get("id")
            if isinstance(sid, int) and sid != 0:
                active_workspaces.add(sid)

    clients_res = run_cmd(["hyprctl", "clients", "-j"])
    if clients_res.returncode != 0:
        return []
    try:
        clients = json.loads(clients_res.stdout)
    except ValueError:
        return []
    if not isinstance(clients, list):
        return []

    boxes: list[str] = []
    for client in clients:
        if not isinstance(client, dict):
            continue
        if not client.get("mapped") or client.get("hidden"):
            continue
        ws = client.get("workspace")
        ws_id = ws.get("id") if isinstance(ws, dict) else None
        if active_workspaces and ws_id not in active_workspaces:
            continue
        at = client.get("at")
        size = client.get("size")
        if not (isinstance(at, list) and len(at) == 2 and isinstance(size, list) and len(size) == 2):
            continue
        x, y = int(at[0]), int(at[1])
        w, h = int(size[0]), int(size[1])
        if w <= 0 or h <= 0:
            continue
        title = str(client.get("title") or client.get("class") or "").replace("\n", " ").strip()
        if title:
            boxes.append(f"{x},{y} {w}x{h} {title}")
        else:
            boxes.append(f"{x},{y} {w}x{h}")
    return boxes


def get_active_window_geometry() -> str | None:
    res = run_cmd(["hyprctl", "activewindow", "-j"])
    if res.returncode != 0:
        return None
    try:
        win = json.loads(res.stdout)
    except ValueError:
        return None
    if not isinstance(win, dict) or not win.get("address"):
        return None
    at = win.get("at")
    size = win.get("size")
    if not (isinstance(at, list) and len(at) == 2 and isinstance(size, list) and len(size) == 2):
        return None
    x, y = int(at[0]), int(at[1])
    w, h = int(size[0]), int(size[1])
    if w <= 0 or h <= 0:
        return None
    return f"{x},{y} {w}x{h}"


def run_slurp(extra_args: list[str] | None = None, stdin_text: str | None = None) -> str | None:
    if kill_pidfile(SLURP_PID_FILE, expected_cmd=b"slurp"):
        return None

    cmd = [
        "slurp",
        "-d",
        "-b",
        SLURP_BG,
        "-c",
        SLURP_BORDER,
        "-s",
        SLURP_SELECTION,
        "-B",
        SLURP_BOX,
        "-F",
        SLURP_FONT,
        "-w",
        "2",
    ]
    if extra_args:
        cmd.extend(extra_args)

    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    SLURP_PID_FILE.write_text(str(proc.pid))
    try:
        stdout, _ = proc.communicate(stdin_text)
    finally:
        try:
            if SLURP_PID_FILE.exists() and SLURP_PID_FILE.read_text().strip() == str(proc.pid):
                SLURP_PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass

    if proc.returncode != 0:
        return None
    geom = stdout.strip()
    return geom or None


def parse_png_dimensions(png_bytes: bytes) -> tuple[int, int] | None:
    if len(png_bytes) >= 24 and png_bytes[:8] == b"\x89PNG\r\n\x1a\n" and png_bytes[12:16] == b"IHDR":
        width, height = struct.unpack(">II", png_bytes[16:24])
        return width, height
    return None


def copy_png_to_clipboard(png_bytes: bytes) -> bool:
    # wl-copy forks a background helper to serve paste requests; do not capture stdout/stderr
    # or Python will hang waiting for the background process to close those pipes.
    res = subprocess.run(
        ["wl-copy", "--type", "image/png"],
        input=png_bytes,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return res.returncode == 0


def next_screenshot_path(save_dir: Path) -> Path:
    save_dir.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    candidate = save_dir / f"screenshot-{stamp}.png"
    counter = 1
    while candidate.exists():
        candidate = save_dir / f"screenshot-{stamp}-{counter}.png"
        counter += 1
    return candidate


def format_display_path(path: Path) -> str:
    try:
        rel = path.relative_to(Path.home())
        return f"~/{rel}"
    except ValueError:
        return str(path)


def capture(
    mode: str,
    save: bool = False,
    save_dir: Path = DEFAULT_SAVE_DIR,
    delay: float = 0.0,
) -> int:
    grim_args: list[str] = ["grim"]

    if mode == "region":
        if delay > 0:
            time.sleep(delay)
        geom = run_slurp()
        if not geom:
            return 0
        grim_args.extend(["-g", geom])
    elif mode == "window":
        if delay > 0:
            time.sleep(delay)
        boxes = list_visible_window_geometries()
        if not boxes:
            notify("Screenshot", "No visible windows to capture", urgency="normal")
            return 1
        geom = run_slurp(["-r"], stdin_text="\n".join(boxes) + "\n")
        if not geom:
            return 0
        grim_args.extend(["-g", geom])
    elif mode == "active-window":
        if delay > 0:
            time.sleep(delay)
        geom = get_active_window_geometry()
        if not geom:
            notify("Screenshot", "No active window to capture", urgency="normal")
            return 1
        grim_args.extend(["-g", geom])
    elif mode == "monitor":
        output = detect_cursor_output()
        if not output:
            notify("Screenshot", "Could not detect current monitor", urgency="critical")
            return 1
        if delay > 0:
            time.sleep(delay)
        grim_args.extend(["-o", output])
    elif mode == "all":
        if delay > 0:
            time.sleep(delay)
    else:
        notify("Screenshot", f"Unknown mode: {mode}", urgency="critical")
        return 1

    grim_args.append("-")
    res = subprocess.run(grim_args, capture_output=True, check=False)
    if res.returncode != 0 or not res.stdout:
        err = res.stderr.decode("utf-8", errors="replace").strip() if res.stderr else "grim failed"
        notify("Screenshot failed", err, urgency="critical")
        return 1

    png_bytes = res.stdout
    copied = copy_png_to_clipboard(png_bytes)
    dims = parse_png_dimensions(png_bytes)
    dims_text = f"{dims[0]}×{dims[1]}" if dims else ""
    mode_label = MODE_LABELS.get(mode, mode)

    saved_path: Path | None = None
    icon_path: str | None = None
    if save:
        try:
            saved_path = next_screenshot_path(save_dir)
            saved_path.write_bytes(png_bytes)
            icon_path = str(saved_path)
        except OSError as exc:
            notify("Failed to save screenshot", str(exc), urgency="critical")
            return 1
    else:
        try:
            PREVIEW_FILE.write_bytes(png_bytes)
            icon_path = str(PREVIEW_FILE)
        except OSError:
            icon_path = None

    if saved_path and copied:
        summary = "Screenshot saved & copied"
        detail = format_display_path(saved_path)
        body = f"{detail} ({dims_text})" if dims_text else detail
    elif saved_path:
        summary = "Screenshot saved"
        detail = format_display_path(saved_path)
        body = f"{detail} ({dims_text})" if dims_text else detail
    elif copied:
        summary = "Screenshot copied"
        body = f"{mode_label} · {dims_text}" if dims_text else mode_label
    else:
        notify("Screenshot failed", "Could not copy image to clipboard", urgency="critical")
        return 1

    notify(summary, body, icon=icon_path)
    return 0


def run_fuzzel(entries: list[tuple[str, str]], output: str | None) -> str | None:
    cmd = [
        "fuzzel",
        "--dmenu",
        "--index",
        "--minimal-lines",
        f"--lines={len(entries)}",
        "--anchor=center",
        "--width=28",
        "--prompt=󰄀  ",
        "--placeholder=Screenshot...",
    ]
    if output:
        cmd.append(f"--output={output}")

    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    PID_FILE.write_text(str(proc.pid))
    try:
        stdout, _ = proc.communicate("\n".join(label for label, _ in entries))
    finally:
        try:
            if PID_FILE.exists() and PID_FILE.read_text().strip() == str(proc.pid):
                PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass

    if proc.returncode != 0:
        return None
    try:
        return entries[int(stdout.strip())][1]
    except (ValueError, IndexError):
        return None


def run_menu(initial_save: bool, save_dir: Path) -> int:
    if kill_pidfile(PID_FILE, expected_cmd=b"fuzzel"):
        return 0
    for other in OTHER_PID_FILES:
        kill_pidfile(other, expected_cmd=b"fuzzel")

    output = detect_cursor_output()
    save_to_file = initial_save

    while True:
        save_label = (
            "󰆓  Save to file: On  󰄬" if save_to_file else "󰆓  Save to file: Off"
        )
        entries = [
            ("󰩭  Region", "region"),
            ("󰖯  Window", "window"),
            ("󰍹  Current monitor", "monitor"),
            ("󰍺  All monitors", "all"),
            (save_label, "toggle-save"),
        ]
        choice = run_fuzzel(entries, output)
        if choice is None:
            return 0
        if choice == "toggle-save":
            save_to_file = not save_to_file
            continue

        # Wait briefly for Fuzzel's layer fade-out animation before capturing
        fade_delay = 0.25 if choice in ("monitor", "all") else 0.05
        return capture(choice, save=save_to_file, save_dir=save_dir, delay=fade_delay)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Minimal Wayland screenshot utility with Fuzzel menu for Hyprland."
    )
    parser.add_argument(
        "mode",
        nargs="?",
        default="menu",
        choices=["menu", "region", "window", "active-window", "monitor", "all"],
        help="Capture mode or 'menu' (default: menu).",
    )
    parser.add_argument(
        "-s",
        "--save",
        action="store_true",
        help="Also save the screenshot to a PNG file (default: clipboard only).",
    )
    parser.add_argument(
        "--dir",
        type=Path,
        default=DEFAULT_SAVE_DIR,
        help="Directory for saved screenshots (default: ~/Pictures/Screenshots).",
    )
    parser.add_argument(
        "--delay",
        type=float,
        default=0.0,
        help="Delay in seconds before capturing.",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.mode == "menu":
        return run_menu(initial_save=args.save, save_dir=args.dir)
    return capture(args.mode, save=args.save, save_dir=args.dir, delay=max(0.0, args.delay))


if __name__ == "__main__":
    sys.exit(main())
