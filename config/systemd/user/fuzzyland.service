[Unit]
Description=fuzzyland shell daemon for Hyprland, Waybar, and Fuzzel
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fuzzyland daemon
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
