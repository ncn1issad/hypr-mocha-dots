{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "spacing": 3,
  "fixed-center": true,
  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["mpris", "hyprland/window"],
  "modules-center": ["hyprland/workspaces", "clock", "idle_inhibitor", "custom/clipboard"],
  "modules-right": ["tray", "network", "bluetooth", "backlight", "custom/external-backlight", "pulseaudio#output", "pulseaudio#input", "custom/battery", "custom/power"],
  "custom/power": {
    "format": "󰐥<span font_family='JetBrains Mono'>&#8203;</span>",
    "tooltip-format": "Power menu (right-click: wlogout)",
    "on-click": "$HOME/.local/bin/fuzzyland power",
    "on-click-right": "/usr/bin/wlogout"
  },
  "tray": { "spacing": 8 },
  "hyprland/window": { "max-length": 48 },
  "hyprland/workspaces": { "format": "{name}" },
  "mpris": {
    "interval": 1,
    "format": "󰎇 {title}",
    "format-paused": "󰎇 {title}",
    "format-stopped": "",
    "dynamic-order": ["artist", "album"],
    "dynamic-separator": "  ·  ",
    "player-icons": {
      "default": "󰎇",
      "chromium": "󰊯",
      "firefox": "󰈹",
      "spotify": "󰓇",
      "vlc": "󰕼"
    },
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤"
    },
    "tooltip-format": "<b><span color='#cdd6f4'>󰎇  {title}</span></b>\n<span color='#b4befe'>󰠃  {dynamic}</span>\n<span color='#a6adc8'>{status_icon}  {status}  ·  {player_icon} {player}  ·  󰔛 {position}/{length}</span>\n<span color='#45475a'>──────────────────────────</span>\n<span color='#7f849c'>󰍽  Left 󰐎  ·  Middle 󰒮  ·  Right 󰒭</span>",
    "max-length": 30,
    "on-click": "$HOME/.local/bin/fuzzyland media play-pause",
    "on-click-middle": "$HOME/.local/bin/fuzzyland media prev",
    "on-click-right": "$HOME/.local/bin/fuzzyland media skip"
  },
  "clock": {
    "format": "󰅐 {:%H:%M}",
    "format-alt": "󰃭 {:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "idle_inhibitor": {
    "format": "{icon}<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle inhibitor: awake · auto-lock paused",
    "tooltip-format-deactivated": "Idle inhibitor: off · auto-lock active"
  },
  "custom/clipboard": {
    "format": "󰅌<span font_family='JetBrains Mono'>&#8203;</span>",
    "tooltip-format": "Clipboard history\nLeft: Open history · Right: Clear history",
    "on-click": "$HOME/.local/bin/fuzzyland clipboard",
    "on-click-right": "$HOME/.local/bin/fuzzyland clipboard --clear"
  },
  "network": {
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-disconnected": "󰤮<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}\nLeft: Network menu · Right: Toggle Wi-Fi",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}\nLeft: Network menu · Right: Toggle Wi-Fi",
    "tooltip-format-disconnected": "Disconnected\nLeft: Network menu · Right: Toggle Wi-Fi",
    "on-click": "$HOME/.local/bin/fuzzyland network",
    "on-click-right": "$HOME/.local/bin/fuzzyland network --toggle-wifi"
  },
  "bluetooth": {
    "format": "󰂯<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-on": "󰂯<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-off": "󰂲<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-disabled": "󰂲<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-no-controller": "󰂲<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-connected": "󰂱<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-connected-battery": "󰂱<span font_family='JetBrains Mono'>&#8203;</span>",
    "tooltip-format": "{controller_alias} · {status}\nLeft: Bluetooth menu · Right: Toggle power",
    "tooltip-format-on": "{controller_alias} · On (no devices)\nLeft: Bluetooth menu · Right: Power off",
    "tooltip-format-off": "{controller_alias} · Off\nLeft: Bluetooth menu · Right: Power on",
    "tooltip-format-disabled": "{controller_alias} · Disabled\nLeft: Bluetooth menu · Right: Enable",
    "tooltip-format-no-controller": "Bluetooth · No controller found",
    "tooltip-format-connected": "{controller_alias} · {num_connections} connected\n{device_enumerate}\nLeft: Bluetooth menu · Right: Power off",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "$HOME/.local/bin/fuzzyland bluetooth",
    "on-click-right": "$HOME/.local/bin/fuzzyland bluetooth --toggle-power"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "$HOME/.local/bin/fuzzyland backlight internal adjust +5",
    "on-scroll-down": "$HOME/.local/bin/fuzzyland backlight internal adjust -5"
  },
  "custom/external-backlight": {
    "exec": "$HOME/.local/bin/fuzzyland backlight status",
    "return-type": "json",
    "on-scroll-up": "$HOME/.local/bin/fuzzyland backlight adjust +5",
    "on-scroll-down": "$HOME/.local/bin/fuzzyland backlight adjust -5",
    "on-click": "$HOME/.local/bin/fuzzyland backlight refresh"
  },
  "pulseaudio#output": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂯 {volume}%",
    "format-bluetooth-muted": "󰖁<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-muted": "󰖁<span font_family='JetBrains Mono'>&#8203;</span>",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "{desc} · {volume}%\nLeft: Output &amp; EQ · Middle: Toggle EQ · Right: Mute",
    "on-click": "$HOME/.local/bin/fuzzyland audio output",
    "on-click-right": "$HOME/.local/bin/fuzzyland audio output --toggle-mute",
    "on-click-middle": "$HOME/.local/bin/fuzzyland audio output --toggle-eq",
    "on-scroll-up": "$HOME/.local/bin/fuzzyland audio output --volume +5",
    "on-scroll-down": "$HOME/.local/bin/fuzzyland audio output --volume -5"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-bluetooth": "{format_source}",
    "format-muted": "{format_source}",
    "format-bluetooth-muted": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "<span color='#f38ba8'>󰍭</span><span font_family='JetBrains Mono'>&#8203;</span>",
    "tooltip-format": "{source_desc} · {source_volume}%\nLeft: Input &amp; Mic FX · Middle: Toggle FX · Right: Mute",
    "on-click": "$HOME/.local/bin/fuzzyland audio input",
    "on-click-right": "$HOME/.local/bin/fuzzyland audio input --toggle-mute",
    "on-click-middle": "$HOME/.local/bin/fuzzyland audio input --toggle-fx",
    "on-scroll-up": "$HOME/.local/bin/fuzzyland audio input --volume +5",
    "on-scroll-down": "$HOME/.local/bin/fuzzyland audio input --volume -5"
  },
  "custom/battery": {
    "exec": "$HOME/.local/bin/fuzzyland battery status",
    "return-type": "json",
    "on-click": "$HOME/.local/bin/fuzzyland battery menu"
  }
}
