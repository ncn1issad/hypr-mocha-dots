{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "spacing": 3,
  "fixed-center": true,
  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["mpris", "hyprland/window"],
  "modules-center": ["hyprland/workspaces", "clock", "idle_inhibitor"],
  "modules-right": ["tray", "network", "backlight", "pulseaudio", "battery", "custom/power"],
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu (right-click: wlogout)",
    "on-click": "$HOME/.local/bin/waybar-power-menu",
    "on-click-right": "/usr/bin/wlogout"
  },
  "tray": { "spacing": 8 },
  "hyprland/window": { "max-length": 48 },
  "hyprland/workspaces": { "format": "{name}" },
  "mpris": {
    "format": "󰎇 {title}",
    "format-paused": "",
    "max-length": 30
  },
  "clock": {
    "format": "󰅐 {:%H:%M}",
    "format-alt": "󰃭 {:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle inhibitor: awake",
    "tooltip-format-deactivated": "Idle inhibitor: idle"
  },
  "network": {
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "$HOME/.local/bin/waybar-network-menu",
    "on-click-right": "/usr/bin/nm-connection-editor"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} 󰂯 {volume}%",
    "format-bluetooth-muted": "󰖁 󰂯",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "{desc} · {volume}%"
  },
  "battery": {
    "bat": "BAT1",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": { "warning": 25, "critical": 10 }
  }
}
