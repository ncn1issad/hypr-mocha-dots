{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "spacing": 3,
  "fixed-center": true,
  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["mpris", "hyprland/window"],
  "modules-center": ["hyprland/workspaces", "clock", "idle_inhibitor"],
  "modules-right": ["tray", "network", "backlight", "pulseaudio", "battery", "custom/power"],
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power menu",
    "on-click": "/usr/bin/wlogout"
  },
  "tray": { "spacing": 8, "orders": { "nm-applet": 10 } },
  "hyprland/window": { "max-length": 48 },
  "hyprland/workspaces": { "format": "{name}" },
  "mpris": { "format": "{title}", "format-paused": "", "max-length": 30 },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "Awake", "deactivated": "Idle" }
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format-wifi": "{essid} · {ipaddr}"
  },
  "backlight": { "device": "intel_backlight", "format": "Light {percent}%" },
  "pulseaudio": { "format": "Vol {volume}%", "format-muted": "Muted" },
  "battery": {
    "bat": "BAT1",
    "format": "{capacity}%",
    "format-charging": "Charging {capacity}%",
    "states": { "warning": 25, "critical": 10 }
  }
}
